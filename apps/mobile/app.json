{
  "expo": {
    "name": "odyssey",
    "slug": "odyssey",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "odyssey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.odyssey.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.odyssey.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
