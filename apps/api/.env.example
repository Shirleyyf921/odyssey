NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Railway provisions these. Without DATABASE_URL the API runs in-memory with a demo
# conversation (development only).
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# EVERYDAY tier: OpenAI-compatible. Novita by default; point NOVITA_BASE_URL at
# DeepInfra or another host for failover.
# NOVITA_API_KEY=
# NOVITA_BASE_URL=https://api.novita.ai/v3/openai
# NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct

# PIVOTAL tier.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# NOVITA_EMBEDDING_MODEL=baai/bge-m3   # 1024 dims, must match db/schema.ts

# Crisis classifier: a small model on the same host, one word per message, before
# generation. Required in production. `pnpm eval:crisis` scores a model against the
# labeled set in src/safety/crisis-eval-set.ts.
# CRISIS_MODEL=meta-llama/llama-3.1-8b-instruct
# CRISIS_TIMEOUT_MS=3000

# Tier that runs memory extraction and summaries (EVERYDAY | PIVOTAL).
# MEMORY_TIER=PIVOTAL

# Sign-in. Apple verifies against the bundle id; Google needs every OAuth client id
# (iOS, Android, web) that may mint id_tokens, comma-separated. The `dev` provider is
# available automatically outside production.
# APPLE_BUNDLE_ID=com.odyssey.app
# GOOGLE_CLIENT_IDS=
# SESSION_TTL_DAYS=30
